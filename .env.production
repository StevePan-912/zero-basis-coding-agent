# ZerGO Coding Agent - Production Environment Configuration
# Copy this file to .env and fill in the values

# ===========================================
# Database Configuration
# ===========================================
DB_USER=zergo
DB_PASSWORD=change_this_to_a_strong_password
DB_NAME=zergo_db

# ===========================================
# LLM API Keys
# ===========================================
# Get your Claude API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Get your OpenAI API key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Security Keys
# ===========================================
# Generate a strong secret key for JWT token signing
# Example: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_random_secret_key

# Flask secret key for session management
# Example: openssl rand -hex 32
SECRET_KEY=change_this_to_another_random_secret_key

# ===========================================
# JWT Configuration
# ===========================================
# Token expiration time in seconds (default: 1 hour)
JWT_ACCESS_TOKEN_EXPIRES=3600

# ===========================================
# Cost Control Configuration
# ===========================================
# API call limits for different user tiers
FREE_TIER_API_LIMIT=50
PAID_TIER_API_LIMIT=500

# ===========================================
# Flask Configuration
# ===========================================
DEBUG=False
HOST=0.0.0.0
PORT=5000

# ===========================================
# Port Configuration (Docker)
# ===========================================
# Uncomment to change default ports
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=5000
# FRONTEND_PORT=80